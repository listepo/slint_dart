import { Button, CheckBox, LineEdit, ListView, VerticalBox, HorizontalBox } from "std-widgets.slint";

export struct TodoItem {
    title: string,
    checked: bool,
}

// Deliberately unreferenced by the Dart code: exists to prove the release
// link hook tree-shakes components without a recorded use out of the dylib.
export component UnusedGadget inherits Window {
    preferred-width: 200px;
    preferred-height: 100px;
    title: "Never shipped";

    in property <string> label: "unused";
    callback poke();

    Text { text: root.label; }
}

export component TodoApp inherits Window {
    preferred-width: 400px;
    preferred-height: 600px;
    title: "Slint ♥ Flutter — Todo";

    // Host (Dart) owns the list; this default renders before the host syncs.
    in property <[TodoItem]> todo-model: [
        { title: "Wire Slint into Flutter", checked: true },
        { title: "Render this list", checked: false },
    ];

    // Named arguments carry through to the generated Dart signatures.
    callback add-todo(title: string);
    callback toggle-todo(index: int, checked: bool);
    callback remove-done();

    VerticalBox {
        HorizontalBox {
            padding: 0;
            edit := LineEdit {
                placeholder-text: "What needs to be done?";
                accepted(text) => { root.add-todo(text); self.text = ""; }
            }
            Button {
                text: "Add";
                primary: true;
                clicked => { root.add-todo(edit.text); edit.text = ""; }
            }
        }
        ListView {
            for item[index] in root.todo-model: HorizontalBox {
                padding: 0;
                CheckBox {
                    text: item.title;
                    checked: item.checked;
                    toggled => { root.toggle-todo(index, self.checked); }
                }
            }
        }
        Button {
            text: "Remove done items";
            clicked => { root.remove-done(); }
        }
    }
}
